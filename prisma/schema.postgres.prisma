generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Trend {
  id                String    @id @default(cuid())
  keyword           String
  normalizedKeyword String    @unique
  traffic           String?
  relatedQueries    String    @default("[]")
  sourceUrls        String    @default("[]")
  sourceContext     String    @default("[]")
  category          String?
  generationStatus  String    @default("idle")
  generationError   String?
  discoveredAt      DateTime  @default(now())
  generatedAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  post              Post?

  @@index([generationStatus])
  @@index([discoveredAt])
}

model User {
  id             String          @id @default(cuid())
  email          String          @unique
  emailVerified  DateTime?
  name           String?
  image          String?
  role           String          @default("admin")
  passwordHash   String?
  accounts       Account[]
  sessions       Session[]
  authenticators Authenticator[]
  savedStories   SavedStory[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([role])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Authenticator {
  credentialID         String  @unique
  userId               String
  providerAccountId    String
  credentialPublicKey  String
  counter              Int
  credentialDeviceType String
  credentialBackedUp   Boolean
  transports           String?
  user                 User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, credentialID])
}

model Category {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  description String?
  posts       Post[]
  feeds       Feed[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model FeedFolder {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  color       String?
  feeds       Feed[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([name])
}

model Feed {
  id            String      @id @default(cuid())
  folderId      String?
  folder        FeedFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)
  categoryId    String?
  category      Category?   @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  title         String
  slug          String      @unique
  siteUrl       String?
  feedUrl       String      @unique
  description   String?
  imageUrl      String?
  active        Boolean     @default(true)
  fetchStatus   String      @default("idle")
  lastFetchedAt DateTime?
  lastError     String?
  stories       FeedStory[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([folderId])
  @@index([categoryId])
  @@index([active])
  @@index([lastFetchedAt])
}

model FeedStory {
  id          String       @id @default(cuid())
  feedId      String
  feed        Feed         @relation(fields: [feedId], references: [id], onDelete: Cascade)
  externalId  String       @unique
  title       String
  slug        String
  excerpt     String?
  content     String?
  sourceUrl   String
  author      String?
  imageUrl    String?
  publishedAt DateTime?
  fetchedAt   DateTime     @default(now())
  isRead      Boolean      @default(false)
  savedBy     SavedStory[]
  tags        StoryTag[]
  posts       Post[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([feedId])
  @@index([publishedAt])
  @@index([isRead])
  @@index([sourceUrl])
}

model SavedStory {
  id        String    @id @default(cuid())
  storyId   String
  story     FeedStory @relation(fields: [storyId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  note      String?
  createdAt DateTime  @default(now())

  @@unique([storyId, userId])
  @@index([userId])
}

model StoryTag {
  id        String      @id @default(cuid())
  name      String      @unique
  slug      String      @unique
  stories   FeedStory[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
}

model Post {
  id                   String           @id @default(cuid())
  trendId              String?          @unique
  trend                Trend?           @relation(fields: [trendId], references: [id], onDelete: SetNull)
  researchCandidateId  String?
  sourceStoryId        String?
  sourceStory          FeedStory?       @relation(fields: [sourceStoryId], references: [id], onDelete: SetNull)
  categoryId           String?
  category             Category?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  title                String
  slug                 String           @unique
  subtitle             String?
  excerpt              String
  summary              String?
  content              String
  seoTitle             String
  seoDescription       String
  openGraphDescription String?
  facebookCaption      String
  authorName           String           @default("Daily Signal Wire Desk")
  readingTimeMinutes   Int?
  keyTakeaways         String           @default("[]")
  timeline             String           @default("[]")
  relatedTopics        String           @default("[]")
  internalLinkSuggestions String        @default("[]")
  draftVersion         Int              @default(1)
  journalistTone       String           @default("Neutral")
  generationMetadata   String           @default("{}")
  tokenUsage           String           @default("{}")
  generationTimeMs     Int?
  promptVersion        String?
  tags                 String           @default("[]")
  faq                  String           @default("[]")
  imagePrompt          String?
  imageModel           String?
  imageGeneratedAt     DateTime?
  imageStatus          String           @default("idle")
  imageError           String?
  imageUrl             String?
  featuredImageUrl     String?
  featuredImage        String?
  thumbnailImage       String?
  openGraphImage       String?
  twitterImage         String?
  imageStorage         String           @default("url")
  featuredImageData    String?
  thumbnailImageData   String?
  imageAlt             String?
  imageCaption         String?
  imageDisclosure      String?
  imageSourceType      String           @default("placeholder")
  imageLicense         String?
  imageCredit          String?
  generatedImages      GeneratedImage[]
  revisions            PostRevision[]
  factCheckReports     FactCheckReport[]
  aiGenerated          Boolean          @default(false)
  factCheckNotes       String           @default("[]")
  sourceUrls           String           @default("[]")
  factCheckStatus      String           @default("Needs Review")
  trustScore           Int?
  evidenceScore        Int?
  sourceDiversityScore Int?
  freshnessScore       Int?
  confidenceLevel      String?
  factCheckSummary     String?
  factCheckEvidence    String           @default("[]")
  factCheckWarnings    String           @default("[]")
  riskyParagraphs      String           @default("[]")
  verificationMetadata String           @default("{}")
  verifiedAt           DateTime?
  status               String           @default("draft")
  scheduledAt          DateTime?
  publishAt            DateTime?
  timezone             String?
  approvalStatus       String           @default("pending")
  approvedAt           DateTime?
  approvedBy           String?
  publishingStartedAt  DateTime?
  publishError         String?
  schedulerMetadata    String           @default("{}")
  rejectedAt           DateTime?
  rejectionReason      String?
  publishedAt          DateTime?
  statusEvents         PostStatusEvent[]
  approvalEvents       PostApprovalEvent[]
  notifications        EditorialNotification[]
  contentPlanItems     ContentPlanItem[]
  distributionPublishes DistributionPublish[]
  socialPosts          SocialPost[]
  seoAudits            SeoAudit[]
  discoverAudits       DiscoverAudit[]
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  @@index([status])
  @@index([status, publishedAt])
  @@index([status, categoryId, publishedAt])
  @@index([scheduledAt])
  @@index([publishAt])
  @@index([approvalStatus])
  @@index([approvedAt])
  @@index([publishingStartedAt])
  @@index([publishedAt])
  @@index([createdAt])
  @@index([aiGenerated])
  @@index([imageStatus])
  @@index([factCheckStatus])
  @@index([trustScore])
  @@index([verifiedAt])
  @@index([researchCandidateId])
  @@index([sourceStoryId])
  @@index([categoryId])
}

model PostStatusEvent {
  id         String   @id @default(cuid())
  postId     String
  post       Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  fromStatus String?
  toStatus   String
  action     String
  actor      String?
  note       String?
  metadata   String   @default("{}")
  createdAt  DateTime @default(now())

  @@index([postId])
  @@index([toStatus])
  @@index([action])
  @@index([createdAt])
}

model PostApprovalEvent {
  id        String   @id @default(cuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  action    String
  actor     String?
  note      String?
  metadata  String   @default("{}")
  createdAt DateTime @default(now())

  @@index([postId])
  @@index([action])
  @@index([createdAt])
}

model EditorialNotification {
  id        String    @id @default(cuid())
  postId    String?
  post      Post?     @relation(fields: [postId], references: [id], onDelete: SetNull)
  type      String
  title     String
  message   String
  severity  String    @default("info")
  status    String    @default("unread")
  metadata  String    @default("{}")
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([postId])
  @@index([type])
  @@index([status])
  @@index([severity])
  @@index([createdAt])
}

model ContentPlanItem {
  id             String    @id @default(cuid())
  postId         String?
  post           Post?     @relation(fields: [postId], references: [id], onDelete: SetNull)
  topic          String
  slug           String?
  category       String    @default("US News")
  sourceType     String    @default("manual")
  sourceId       String?
  status         String    @default("planned")
  priority       Int       @default(3)
  plannedFor     DateTime
  timezone       String    @default("UTC")
  frequency      String    @default("one_time")
  angle          String?
  targetKeywords String    @default("[]")
  notes          String?
  owner          String?
  metadata       String    @default("{}")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([postId])
  @@index([status])
  @@index([priority])
  @@index([plannedFor])
  @@index([category])
  @@index([sourceType])
}

model DistributionChannel {
  id             String                @id @default(cuid())
  platform       String                @unique
  label          String
  enabled        Boolean               @default(false)
  mode           String                @default("manual")
  status         String                @default("not_configured")
  configStatus   String                @default("missing_credentials")
  lastCheckedAt  DateTime?
  notes          String?
  metadata       String                @default("{}")
  publishes      DistributionPublish[]
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  @@index([enabled])
  @@index([status])
  @@index([mode])
}

model DistributionPublish {
  id             String               @id @default(cuid())
  postId         String?
  post           Post?                @relation(fields: [postId], references: [id], onDelete: SetNull)
  channelId      String?
  channel        DistributionChannel? @relation(fields: [channelId], references: [id], onDelete: SetNull)
  platform       String
  mode           String               @default("manual")
  status         String               @default("queued")
  scheduledAt    DateTime?
  publishedAt    DateTime?
  retryCount     Int                  @default(0)
  lastError      String?
  destinationUrl String?
  message        String?
  payload        String               @default("{}")
  history        String               @default("[]")
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@index([postId])
  @@index([channelId])
  @@index([platform])
  @@index([status])
  @@index([scheduledAt])
  @@index([publishedAt])
}

model SocialPost {
  id             String    @id @default(cuid())
  platform       String
  articleId      String
  article        Post      @relation(fields: [articleId], references: [id], onDelete: Cascade)
  status         String    @default("queued")
  scheduledAt    DateTime?
  publishedAt    DateTime?
  retryCount     Int       @default(0)
  errorMessage   String?
  copy           String?
  hashtags       String    @default("[]")
  shortSummary   String?
  callToAction   String?
  utmUrl         String?
  trackingUrl    String?
  openGraphImage String?
  squareImage    String?
  verticalImage  String?
  payload        String    @default("{}")
  logs           String    @default("[]")
  externalPostId String?
  clicks         Int       @default(0)
  impressions    Int       @default(0)
  shares         Int       @default(0)
  likes          Int       @default(0)
  comments       Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([articleId, platform])
  @@index([articleId])
  @@index([platform])
  @@index([status])
  @@index([scheduledAt])
  @@index([publishedAt])
  @@index([createdAt])
}

model SeoAudit {
  id             String   @id @default(cuid())
  postId         String
  post           Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  score          Int
  keyword        String?
  checks         String   @default("[]")
  suggestions    String   @default("[]")
  keywords       String   @default("[]")
  duplicateRisk  String   @default("low")
  thinContent    Boolean  @default(false)
  brokenLinks    String   @default("[]")
  metadata       String   @default("{}")
  analyzedAt     DateTime @default(now())
  createdAt      DateTime @default(now())

  @@index([postId])
  @@index([score])
  @@index([duplicateRisk])
  @@index([analyzedAt])
}

model DiscoverAudit {
  id                  String   @id @default(cuid())
  postId              String
  post                Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  score               Int
  freshnessScore      Int
  entityScore         Int
  imageScore          Int
  largePreviewReady   Boolean  @default(false)
  headlineVariations  String   @default("[]")
  suggestions         String   @default("[]")
  metadata            String   @default("{}")
  analyzedAt          DateTime @default(now())
  createdAt           DateTime @default(now())

  @@index([postId])
  @@index([score])
  @@index([freshnessScore])
  @@index([analyzedAt])
}

model RevenueMetric {
  id               String   @id @default(cuid())
  date             DateTime
  source           String   @default("internal")
  pageviews        Int      @default(0)
  sessions         Int      @default(0)
  estimatedRevenue Float?
  ctr              Float?
  rpm              Float?
  topArticles      String   @default("[]")
  topCategories    String   @default("[]")
  topCountries     String   @default("[]")
  trafficSources   String   @default("[]")
  metadata         String   @default("{}")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([date, source])
  @@index([date])
  @@index([source])
}

model AnalyticsEvent {
  id          String   @id @default(cuid())
  eventName   String
  path        String?
  articleSlug String?
  category    String?
  visitorId   String?
  sessionId   String?
  country     String?
  device      String?
  source      String?
  referrer    String?
  durationSeconds Int?
  scrollDepth Int?
  metadata    String   @default("{}")
  createdAt   DateTime @default(now())

  @@index([eventName])
  @@index([path])
  @@index([articleSlug])
  @@index([category])
  @@index([visitorId])
  @@index([sessionId])
  @@index([country])
  @@index([device])
  @@index([source])
  @@index([scrollDepth])
  @@index([createdAt])
}

model IndexingJob {
  id             String    @id @default(cuid())
  url            String
  type           String
  status         String    @default("pending")
  attempts       Int       @default(0)
  lastError      String?
  responseCode   Int?
  responseBody   String?
  responseTimeMs Int?
  nextAttemptAt  DateTime?
  verifiedAt     DateTime?
  submittedAt    DateTime?
  finishedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([url])
  @@index([type])
  @@index([status])
  @@index([createdAt])
  @@index([nextAttemptAt])
  @@index([submittedAt])
  @@index([finishedAt])
}

model SystemStatusCheck {
  id        String   @id @default(cuid())
  key       String
  label     String
  status    String   @default("unknown")
  message   String?
  metadata  String   @default("{}")
  checkedAt DateTime @default(now())

  @@index([key])
  @@index([status])
  @@index([checkedAt])
}

model PostRevision {
  id                      String   @id @default(cuid())
  postId                  String
  post                    Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  version                 Int
  changeType              String
  section                 String?
  tone                    String?
  title                   String?
  subtitle                String?
  excerpt                 String?
  summary                 String?
  content                 String?
  seoTitle                String?
  seoDescription          String?
  openGraphDescription    String?
  facebookCaption         String?
  tags                    String   @default("[]")
  faq                     String   @default("[]")
  keyTakeaways            String   @default("[]")
  timeline                String   @default("[]")
  relatedTopics           String   @default("[]")
  internalLinkSuggestions String   @default("[]")
  factCheckNotes          String   @default("[]")
  sourceUrls              String   @default("[]")
  generationMetadata      String   @default("{}")
  tokenUsage              String   @default("{}")
  generationTimeMs        Int?
  promptVersion           String?
  createdAt               DateTime @default(now())

  @@unique([postId, version])
  @@index([postId])
  @@index([changeType])
  @@index([section])
  @@index([createdAt])
}

model FactCheckReport {
  id                   String   @id @default(cuid())
  postId               String
  post                 Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  status               String   @default("Needs Review")
  trustScore           Int
  evidenceScore        Int
  sourceDiversityScore Int
  freshnessScore       Int
  confidenceLevel      String
  summary              String
  evidence             String   @default("[]")
  warnings             String   @default("[]")
  riskyParagraphs      String   @default("[]")
  metadata             String   @default("{}")
  model                String?
  promptVersion        String?
  createdAt            DateTime @default(now())

  @@index([postId])
  @@index([status])
  @@index([trustScore])
  @@index([createdAt])
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  status    String   @default("active")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AdSlot {
  id        String   @id @default(cuid())
  key       String   @unique
  label     String
  placement String
  enabled   Boolean  @default(true)
  clientId  String?
  slotId    String?
  format    String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([placement])
  @@index([enabled])
}

model GeneratedImage {
  id           String   @id @default(cuid())
  postId       String?
  post         Post?    @relation(fields: [postId], references: [id], onDelete: SetNull)
  prompt       String
  finalPrompt  String?
  generator    String?
  model        String?
  status       String   @default("generated")
  url          String?
  featuredUrl  String?
  thumbnailUrl String?
  openGraphUrl String?
  twitterUrl   String?
  webpUrl      String?
  avifUrl      String?
  width        Int?
  height       Int?
  format       String?
  alt          String?
  title        String?
  description  String?
  caption      String?
  disclosure   String?
  sourceType   String   @default("ai")
  illustrative Boolean  @default(true)
  storage      String?
  category     String?
  metadata     String   @default("{}")
  validationNotes String @default("[]")
  generationCostUsd Float?
  generationTimeMs  Int?
  promptVersion String?
  promptTemplate String?
  license      String?
  credit       String?
  error        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([postId])
  @@index([status])
  @@index([sourceType])
  @@index([illustrative])
  @@index([category])
  @@index([promptVersion])
}

model SiteSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  type      String   @default("string")
  group     String   @default("general")
  isPublic  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([group])
  @@index([isPublic])
}

model ResearchCandidate {
  id                String           @id @default(cuid())
  clusterKey        String           @unique
  topic             String
  normalizedTopic   String
  category          String
  region            String           @default("US")
  language          String           @default("en-US")
  trendScore        Float            @default(0)
  freshnessScore    Float            @default(0)
  opportunityScore  Float            @default(0)
  riskLevel         String           @default("low")
  factCheckRequired Boolean          @default(false)
  status            String           @default("new")
  recommendedAction String           @default("monitor")
  firstSeenAt       DateTime         @default(now())
  lastSeenAt        DateTime         @default(now())
  sources           ResearchSource[]
  brief             ResearchBrief?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([normalizedTopic])
  @@index([category])
  @@index([riskLevel])
  @@index([status])
  @@index([recommendedAction])
  @@index([trendScore])
  @@index([lastSeenAt])
}

model ResearchSource {
  id              String            @id @default(cuid())
  candidateId     String
  candidate       ResearchCandidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  source          String
  publisher       String?
  sourceUrl       String
  canonicalUrl    String
  externalId      String?
  headline        String
  summary         String?
  credibilityTier String            @default("C")
  publishedAt     DateTime?
  rawMetadata     String            @default("{}")
  createdAt       DateTime          @default(now())

  @@unique([candidateId, canonicalUrl])
  @@unique([source, externalId])
  @@index([candidateId])
  @@index([source])
  @@index([publisher])
  @@index([credibilityTier])
  @@index([publishedAt])
}

model ResearchBrief {
  id                String            @id @default(cuid())
  candidateId       String            @unique
  candidate         ResearchCandidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  whyTrending       String
  readerValue       String
  verifiedFacts     String            @default("[]")
  uncertainClaims   String            @default("[]")
  timeline          String            @default("[]")
  keyEntities       String            @default("[]")
  relatedQueries    String            @default("[]")
  suggestedAngles   String            @default("[]")
  suggestedKeywords String            @default("[]")
  factCheckNotes    String            @default("[]")
  intent            String?
  sourceUrls        String            @default("[]")
  sourceCredibility String            @default("[]")
  scoreBreakdown    String            @default("{}")
  riskLevel         String            @default("low")
  recommendedAction String            @default("monitor")
  factCheckRequired Boolean           @default(false)
  generatedAt       DateTime          @default(now())
  model             String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@index([generatedAt])
}

model ResearchRun {
  id                String    @id @default(cuid())
  startedAt         DateTime  @default(now())
  completedAt       DateTime?
  status            String    @default("running")
  sourceStatuses    String    @default("{}")
  candidatesFound   Int       @default(0)
  candidatesCreated Int       @default(0)
  candidatesMerged  Int       @default(0)
  errorSummary      String?

  @@index([status])
  @@index([startedAt])
}
