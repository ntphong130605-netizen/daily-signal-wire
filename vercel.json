{
  "buildCommand": "npm run build:vercel",
  "crons": [
    {
      "path": "/api/cron/feeds",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/cron/trends",
      "schedule": "0 1 * * *"
    },
    {
      "path": "/api/cron/research",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/cron/publish",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/indexing",
      "schedule": "15 3 * * *"
    },
    {
      "path": "/api/cron/social",
      "schedule": "*/30 * * * *"
    }
  ]
}
